# =============================================================================
# Stærk50 – environment variables
# Copy to .env.local for local development. In Vercel, add the same variables
# under Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are visible in the browser – never put
# secrets in them.
# =============================================================================

# Public URL of the site (no trailing slash). Used in emails and payment redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ----------------------------------
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key – SERVER ONLY. Bypasses Row Level Security.
# Starts with sb_secret_
SUPABASE_SECRET_KEY=

# --- Stripe (Dashboard → Developers → API keys) -------------------------------
# Use test keys (sk_test_/pk_test_) until the real price is set and tested.
# Starts with sk_test_ (test mode) or sk_live_ (live mode)
STRIPE_SECRET_KEY=
# Starts with pk_test_ or pk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (Dashboard → Developers → Webhooks, or `stripe listen`).
# Starts with whsec_
STRIPE_WEBHOOK_SECRET=

# --- Email via Resend (optional; app emails stay off until set) ---------------
RESEND_API_KEY=
# Verified sender, e.g. "Stærk50 <hej@ditdomæne.dk>"
EMAIL_FROM=

# --- Vipps MobilePay Recurring (NOT enabled – requires a merchant agreement) --
# Leave empty. See docs/MOBILEPAY.md before filling these in.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_TEST_MODE=true
